# ==============================================================================
# UdaanHer AWS EC2 Production Environment Configuration
# "Giving women wings to fly"
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5001

# Allowed Client Origins for CORS (comma-separated or single domain/IP)
# Set to your EC2 Public IP or Custom Domain. Example:
# CLIENT_URL=http://54.210.12.34,https://udaanher.org
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Database Connection (MongoDB Atlas Cloud Replica Set)
# ==============================================================================
# Ensure your EC2 Elastic IP is added to MongoDB Atlas Network Access (IP Access List)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.<hash>.mongodb.net/udaanher?retryWrites=true&w=majority"

# Optional test database (used when running integration test suites on EC2)
# DATABASE_URL_TEST="mongodb+srv://<username>:<password>@cluster0.<hash>.mongodb.net/udaanher_test?retryWrites=true&w=majority"

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate a secure 32+ character key: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_32_character_hex_secret_key_for_production
JWT_ACCESS_EXPIRES_IN=24h

# ==============================================================================
# OpenAI Configuration (Plain-Hindi Summary Engine)
# ==============================================================================
# Leave empty if using the safe built-in synthesis fallback engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Statutory NGO Details (Madhya Pradesh & All-India 80G Compliant)
# ==============================================================================
TRUST_NAME=UdaanHer Women Welfare & Empowerment Charitable Trust (Bhopal)
TRUST_ADDRESS=Plot 14, Arera Hills, Bhopal, Madhya Pradesh - 462011
TRUST_PAN=AAATC1234D
TRUST_80G_REGISTRATION=CIT(E)/BPL/80G/2021-22/A-1089

# ==============================================================================
# PDF Storage & Receipts
# ==============================================================================
PDF_STORAGE_PROVIDER=local
PDF_STORAGE_BUCKET=storage/receipts

