{
  "name": "udaanher-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "UdaanHer Backend REST API Server - Giving women wings to fly",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run tests/unit",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "vitest run tests/concurrency.test.ts",
    "test:integration": "vitest run tests/integration/api.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.8.0",
    "openai": "^4.85.0",
    "pdfkit": "^0.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
