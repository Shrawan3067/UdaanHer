# UdaanHer Frontend Environment Configuration
# Default relative URL for Nginx reverse-proxy on AWS EC2
VITE_API_URL=/api/v1

# If frontend and backend are hosted on different domains/IPs, specify the absolute URL:
# VITE_API_URL=http://<EC2_PUBLIC_IP>:5001/api/v1
# VITE_API_URL=https://api.yourdomain.com/api/v1

